@page
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Placement Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link
href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet">
<script
src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
  :root{
    --ink:#1b2a38; --muted:#5c6b78; --paper:#f3f5f7; --card:#ffffff; --line:#d9e0e6;
    --teal:#1f7a7a; --amber:#d9962b; --brick:#b4493a; --navy:#2b4a66;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 "IBM Plex Sans",system-ui,sans-serif}
  .wrap{max-width:1200px;margin:0 auto;padding:24px 20px 60px}
  header{display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:20px}
  h1{font:600 30px/1.1 Fraunces,Georgia,serif;margin:0}
  header p{margin:4px 0 0;color:var(--muted)}
  h2{font-size:16px;margin:0 0 12px}
  .hero{display:grid;grid-template-columns:1.2fr 2fr;gap:16px;margin-bottom:16px}
  .rate{background:var(--ink);color:#fff;border-radius:6px;padding:22px}
  .rate .big{font:600 64px/1 Fraunces,Georgia,serif}
  .rate .bar{height:8px;background:#ffffff30;border-radius:4px;margin:14px 0 8px;overflow:hidden}
  .rate .bar i{display:block;height:100%;background:var(--amber);width:0;transition:width .8s}
  .rate small{opacity:.75}
  .stats{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:16px}
  .stat b{display:block;font-size:26px;font-weight:600}
  .stat span{color:var(--muted);font-size:13px}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:16px}
  .chart{height:240px;position:relative}
  .split{display:grid;grid-template-columns:2.2fr 1fr;gap:16px}
  .tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
  input,select,textarea,button{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:4px;background:#fff;color:var(--ink)}
  input[type=search]{flex:1;min-width:160px}
  button{cursor:pointer;background:var(--teal);color:#fff;border-color:var(--teal)}
  button.ghost{background:#fff;color:var(--ink);border-color:var(--line)}
  button:disabled{opacity:.5;cursor:not-allowed}
  :focus-visible{outline:3px solid var(--amber);outline-offset:2px}
  .tablewrap{max-height:420px;overflow:auto;border:1px solid var(--line);border-radius:4px}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{padding:8px 10px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
  th{position:sticky;top:0;background:#eaeff3;cursor:pointer;user-select:none}
  .pill{padding:2px 8px;border-radius:10px;font-size:12px;color:#fff}
  .Placed{background:var(--teal)} .Unplaced{background:var(--brick)}
  .drive{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)}
  .drive:last-child{border:0}
  .drive em{font-style:normal;color:var(--muted);font-size:13px;display:block}
  dialog{border:1px solid var(--line);border-radius:6px;width:min(520px,92vw);padding:20px}
  dialog::backdrop{background:#1b2a3866}
  dialog label{display:block;margin:10px 0 4px;font-weight:500}
  dialog input,dialog textarea{width:100%}
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 16px;border-radius:4px;display:none}
  .embed header{display:none}
  @media(max-width:900px){.hero,.grid,.split{grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.rate .bar i{transition:none}}
</style>
</head>
<body>
<div class="wrap" id="root">
 <header>
   <div>
    <h1>Placement dashboard</h1>
    <p>Batch 2026 · live from the placement cell</p>
   </div>
   <button id="emailBtn" disabled>Email selected students</button>
 </header>

 <section class="hero">
  <div class="rate">
   <div>Students placed</div>
   <div class="big" id="pct">0%</div>
   <div class="bar"><i id="bar"></i></div>
   <small id="ratio"></small>
  </div>
  <div class="stats">
   <div class="card stat"><b id="avg">–</b><span>Average package (LPA)</span></div>
   <div class="card stat"><b id="max">–</b><span>Highest package (LPA)</span></div>
   <div class="card stat"><b id="placed">–</b><span>Placed</span></div>
   <div class="card stat"><b id="unplaced">–</b><span>Still looking</span></div>
  </div>
 </section>

 <section class="grid">
   <div class="card"><h2>Placed vs unplaced by department</h2><div class="chart"><canvas id="cDept"></canvas></div></div>
   <div class="card"><h2>Offers by company</h2><div class="chart"><canvas id="cComp"></canvas></div></div>
   <div class="card"><h2>Package distribution</h2><div class="chart"><canvas id="cPkg"></canvas></div></div>
 </section>

 <section class="split">
  <div class="card">
   <h2>Students</h2>
   <div class="tools">
    <input type="search" id="q" placeholder="Search name or company" aria-label="Search students">
    <select id="fDept" aria-label="Department"><option value="">All departments</option></select>
    <select id="fStatus" aria-label="Status">
      <option value="">All statuses</option><option>Placed</option><option>Unplaced</option>
     </select>
    </div>
    <div class="tablewrap">
     <table>
      <thead><tr>
       <th><input type="checkbox" id="all" aria-label="Select all shown"></th>
       <th data-k="name">Name</th><th data-k="department">Dept</th><th data-k="cgpa">CGPA</th>
       <th data-k="status">Status</th><th data-k="company">Company</th><th data-k="packageLpa">LPA</th>
      </tr></thead>
      <tbody id="rows"></tbody>
     </table>
    </div>
  </div>
  <div class="card"><h2>Company drives</h2><div id="drives"></div></div>
 </section>
</div>

<dialog id="dlg">
 <h2>Email <span id="cnt"></span> student(s)</h2>
 <label for="subj">Subject</label>
 <input id="subj" value="Placement update">
 <label for="body">Message (use {name} for the student's name)</label>
 <textarea id="body" rows="6">Hi {name},

A new company drive is open. Please check the placement portal and register
before the deadline.

Placement Cell</textarea>
 <p style="text-align:right;margin:14px 0 0">
  <button class="ghost" id="cancel">Cancel</button>
  <button id="send">Send email</button>
 </p>
</dialog>
<div class="toast" id="toast" role="status"></div>

<script>
const $ = s => document.querySelector(s);
const state = { students: [], sortKey: "name", asc: true, picked: new Set() };
if (new URLSearchParams(location.search).get("embed") === "1")
$("#root").classList.add("embed");

async function init() {
  const [sum, students] = await Promise.all([
    fetch("/api/summary").then(r => r.json()),
    fetch("/api/students").then(r => r.json())
  ]);
  state.students = students;
  renderStats(sum); renderCharts(sum); renderDrives(sum.drives);
  [...new Set(students.map(s => s.department))].sort()
    .forEach(d => $("#fDept").insertAdjacentHTML("beforeend",
`<option>${d}</option>`));
  renderRows();
}

function renderStats(s) {
 $("#pct").textContent = s.percent + "%";
 $("#ratio").textContent = `${s.placed} of ${s.total} students`;
 requestAnimationFrame(() => $("#bar").style.width = s.percent + "%");
 $("#avg").textContent = s.avgPackage; $("#max").textContent = s.maxPackage;
 $("#placed").textContent = s.placed;